# Same-origin dev: leave empty and use VITE_DEV_API_PROXY for the Vite → NestJS proxy target.
VITE_API_URL=
# NestJS listen address for vite.config.ts dev proxy (default http://127.0.0.1:3001).
VITE_DEV_API_PROXY=http://127.0.0.1:3001
# Customer OTP mock in dev (default on in Vite dev — fixed code 123456, no SMS/backend).
# Set to false to call the real /auth/otp/* endpoints.
VITE_MOCK_OTP=true

# Error tracking — omit to disable in local dev (CLAUDE.md Observability rules)
VITE_SENTRY_DSN=
