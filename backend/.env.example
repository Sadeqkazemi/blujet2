NODE_ENV=development
AUTH_SANDBOX_ENABLED=true
AUTH_SANDBOX_OTP=123456
PORT=3000

DATABASE_URL="postgresql://blujet:blujet@localhost:5432/blujet?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"

# Internal-only FastAPI service — never exposed to the frontend/internet.
ML_SERVICE_URL="http://ml-service:8000"
ML_SERVICE_INTERNAL_TOKEN="change-me"

# SMS OTP / notifications — the real Kavenegar API key is NOT an env
# var: it's set/rotated live from پنل مدیر IT → سرویس‌های خارجی (the
# same encrypted-at-rest ExternalServiceConfig row used for زرین‌پال/
# آمادئوس/نشان). Falls back to a log-only mock automatically until an
# IT_MANAGER enables it there. KAVENEGAR_SENDER_LINE below is the only
# SMS-related env var — it's your approved originator line, not a
# secret, and optional (Kavenegar uses the account default if unset).
KAVENEGAR_SENDER_LINE=

# Payment gateway (Shetab/IPG) — sandbox driver in dev
PAYMENT_GATEWAY="sandbox"

# Error tracking — omit to disable in local dev
SENTRY_DSN=

CORS_ORIGINS="http://localhost:5173"

PII_ENCRYPTION_KEY="generate-with: openssl rand -hex 32"

# Real Anthropic API key for the passenger-survey AI summary (Phase 66).
# Omit to disable AI summaries in local dev — the endpoint still works,
# it just returns the design's own fallback string instead of a summary.
ANTHROPIC_API_KEY=

# Public frontend origin — used only to build the survey link sent by SMS.
FRONTEND_URL="http://localhost:5173"

# Bank loan adapter (optional). Never hard-code bank name/URL in code.
# Use the bank's official sandbox URL in non-prod. Leave unset to disable.
BANK_LOAN_API_BASE_URL=
BANK_LOAN_API_KEY=
BANK_LOAN_WEBHOOK_SECRET=
BANK_LOAN_TIMEOUT_MS=5000
